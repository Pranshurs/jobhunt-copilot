# ---------------------------------------------------------------------------
# JobHunt Copilot — configuration
#
# The app speaks the OpenAI-compatible Chat Completions API, so the SAME code
# works across providers. Pick one block below.
#
# Leave LLM_API_KEY empty to run in offline MOCK mode (no key, no network, no cost).
# ---------------------------------------------------------------------------

# --- Groq (free tier, fast) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# --- OpenRouter (many models, one key) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.1-70b-instruct
# LLM_API_KEY=sk-or-...

# --- Local Ollama (fully offline, on your VPS) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# Force a mode ("live" or "mock"); leave empty to auto-detect from LLM_API_KEY.
LLM_MODE=
LLM_TEMPERATURE=0.2
AGENT_MAX_STEPS=8
